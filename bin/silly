#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/bin/silly-common.sh"

DATA_DIR="${SILLY_CODE_DATA:-$HOME/.silly-code}"
mkdir -p "$DATA_DIR"

check_provider() {
  local name="$1" token_file="$2"
  # Check both new (-auth.json) and legacy (-oauth.json) filenames
  local alt_file="${token_file/-oauth.json/-auth.json}"
  if [ -f "$DATA_DIR/$token_file" ] || [ -f "$DATA_DIR/$alt_file" ]; then
    ok "$name: logged in"
    return 0
  else
    warn "$name: not logged in"
    return 1
  fi
}

check_claude() {
  if [ -f "$CLAUDE_CRED" ] || [ -f "$DATA_DIR/$CLAUDE_OAUTH" ]; then
    ok "Claude  (sillye): logged in"
    return 0
  else
    warn "Claude  (sillye): not logged in"
    return 1
  fi
}

case "${1:-}" in
  status)
    echo ""
    echo -e "  ${B}silly-code${N} — Multi-Provider AI Coding Assistant"
    echo ""
    check_provider "Codex   (sillyx)" "$CODEX_OAUTH" || true
    check_provider "Copilot (sillyt)" "$COPILOT_OAUTH" || true
    check_claude || true
    echo ""
    exit 0
    ;;
  login)
    PROVIDER="${2:-}"
    case "$PROVIDER" in
      codex)
        node "$ROOT_DIR/pipeline/login.mjs" codex
        ;;
      copilot)
        node "$ROOT_DIR/pipeline/login.mjs" copilot
        ;;
      claude)
        info "Launching Silly Code — use /login inside the TUI to sign in to claude.ai"
        PATCHED="$ROOT_DIR/pipeline/build/cli-patched.js"
        if [ ! -f "$PATCHED" ]; then
          info "Building patched binary (first run)..."
          node "$ROOT_DIR/pipeline/patch.cjs" || { err "Patch build failed"; exit 1; }
        fi
        exec node "$PATCHED"
        ;;
      "")
        echo "Usage: silly login <provider>"
        echo "Providers: codex, copilot, claude"
        exit 1
        ;;
      *)
        err "Unknown provider: $PROVIDER"
        exit 1
        ;;
    esac
    exit 0
    ;;
  logout)
    PROVIDER="${2:-}"
    case "$PROVIDER" in
      codex)   rm -f "$DATA_DIR/$CODEX_OAUTH" "$DATA_DIR/$CODEX_AUTH";     ok "Codex tokens removed" ;;
      copilot) rm -f "$DATA_DIR/$COPILOT_OAUTH" "$DATA_DIR/$COPILOT_AUTH"; ok "Copilot tokens removed" ;;
      claude)  rm -f "$DATA_DIR/$CLAUDE_OAUTH";  ok "Claude tokens removed" ;;
      "") err "Usage: silly logout <codex|copilot|claude>"; exit 1 ;;
      *) err "Unknown provider: $PROVIDER"; exit 1 ;;
    esac
    exit 0
    ;;
  models)
    echo ""
    echo -e "  ${B}Available Models${N}"
    echo ""
    echo "  Codex (sillyx):"
    echo "    gpt-5.4              1M context (272k practical)"
    echo "    gpt-5.4-mini         Fast mini model"
    echo "    gpt-5.3-codex        Industry-leading coding"
    echo ""
    echo "  Copilot (sillyt):"
    echo "    claude-opus-4-6      128k context (Copilot cap)"
    echo "    claude-sonnet-4      200k context"
    echo "    o3                   200k context"
    echo ""
    echo "  Claude (sillye):"
    echo "    claude-opus-4-6      1M context"
    echo "    claude-sonnet-4-6    1M context"
    echo "    claude-haiku-4-5     200k context"
    echo ""
    exit 0
    ;;
  doctor)
    MISSING=false
    echo ""
    echo -e "  ${B}silly-code doctor${N}"
    echo ""

    # Version / commit
    VERSION=$(cd "$ROOT_DIR" && git describe --tags --always 2>/dev/null || echo "unknown")
    COMMIT=$(cd "$ROOT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "unknown")
    ok "Version: $VERSION (commit $COMMIT)"
    ok "Platform: $(uname -s) $(uname -m)"

    # Runtime
    MISSING=false
    if command -v node >/dev/null 2>&1; then
      NODE_VER=$(node -e "console.log(process.versions.node.split('.')[0])")
      if [ "$NODE_VER" -ge 20 ] 2>/dev/null; then
        ok "Node: $(node --version)"
      else
        err "Node: $(node --version) (need >= 20)"; MISSING=true
      fi
    else
      err "Node: not found"; MISSING=true
    fi
    command -v git >/dev/null 2>&1 && ok "Git: $(git --version | head -1)" || warn "Git: not found (optional)"
    command -v rg >/dev/null 2>&1 && ok "ripgrep: $(rg --version | head -1)" || warn "ripgrep: not found (file search will be slow)"
    PATCHED="$ROOT_DIR/pipeline/build/cli-patched.js"
    [ -f "$PATCHED" ] && ok "Patched binary: found" || { err "Patched binary: missing (run: node pipeline/patch.cjs)"; MISSING=true; }

    # Provider auth
    echo ""
    check_provider "Codex   (sillyx)" "$CODEX_OAUTH" || true
    check_provider "Copilot (sillyt)" "$COPILOT_OAUTH" || true
    check_claude || true

    # Defaults
    echo ""
    ok "Mode: patched binary (upstream + silly-code patches)"

    # AutoDream / memory
    MEMDIR="$HOME/.claude/projects"
    if [ -d "$MEMDIR" ]; then
      MCOUNT=$(find "$MEMDIR" -name "*.md" -path "*/memory/*" 2>/dev/null | wc -l | tr -d ' ')
      ok "Memory files: $MCOUNT across projects"
    else
      info "Memory: no projects yet"
    fi
    ok "AutoDream: enabled (24h + 5 sessions gate)"

    # Computer use
    echo ""
    if [ "$(uname -s)" = "Darwin" ]; then
      [ -f "$ROOT_DIR/runtime/mac_helper.py" ] && ok "Computer use: available (macOS)" || warn "Computer use: mac_helper.py missing"
    else
      info "Computer use: not available (macOS only)"
    fi

    # Fallback
    AUTHED=0
    { [ -f "$DATA_DIR/$CODEX_AUTH" ] || [ -f "$DATA_DIR/$CODEX_OAUTH" ]; } && AUTHED=$((AUTHED+1))
    { [ -f "$DATA_DIR/$COPILOT_AUTH" ] || [ -f "$DATA_DIR/$COPILOT_OAUTH" ]; } && AUTHED=$((AUTHED+1))
    [ -f "$CLAUDE_CRED" ] && AUTHED=$((AUTHED+1))
    if [ "$AUTHED" -ge 2 ]; then
      ok "Provider fallback: active ($AUTHED providers)"
    elif [ "$AUTHED" -eq 1 ]; then
      info "Provider fallback: unavailable (only 1 provider authenticated)"
    else
      warn "Provider fallback: no providers authenticated"
    fi

    echo ""
    [ "$MISSING" = true ] && { err "Some checks failed. Fix the issues above."; exit 1; }
    ok "Ready for use."
    echo ""
    exit 0
    ;;
  cron)
    case "${2:-status}" in
      install)
        exec bash "$ROOT_DIR/bin/install-upgrade-cron.sh"
        ;;
      uninstall)
        if [[ "$(uname -s)" == "Darwin" ]]; then
          PLIST="$HOME/Library/LaunchAgents/com.silly-code.upgrade-check.plist"
          launchctl unload "$PLIST" 2>/dev/null || true
          rm -f "$PLIST"
          ok "launchd agent removed"
        else
          crontab -l 2>/dev/null | grep -v "upgrade-check.sh" | crontab -
          ok "cron entry removed"
        fi
        exit 0
        ;;
      status)
        if [[ "$(uname -s)" == "Darwin" ]]; then
          if launchctl list com.silly-code.upgrade-check >/dev/null 2>&1; then
            ok "launchd agent installed (fires every 4h when Mac is awake)"
            echo "  recent runs:"
            ls -t "$HOME/.silly-code/logs"/upgrade-*.log 2>/dev/null | head -3 | while read f; do
              echo "    $(basename "$f")"
            done
          else
            warn "not installed — run: silly cron install"
          fi
        else
          if crontab -l 2>/dev/null | grep -q "upgrade-check.sh"; then
            ok "cron entry installed"
          else
            warn "not installed — run: silly cron install"
          fi
        fi
        exit 0
        ;;
      run)
        info "running upgrade-check now..."
        exec bash "$ROOT_DIR/bin/upgrade-check.sh"
        ;;
      *)
        err "Unknown cron subcommand: ${2:-}"
        echo "Usage: silly cron {install|uninstall|status|run}"
        exit 1
        ;;
    esac
    ;;
  update)
    echo ""
    echo -e "  ${B}silly-code update${N}"
    echo ""

    # Read deps.json for version info
    DEPS_JSON="$ROOT_DIR/deps.json"
    if [ ! -f "$DEPS_JSON" ]; then
      err "deps.json not found at $ROOT_DIR"
      exit 1
    fi

    UPDATE_MODE="${2:-check}"

    # ── Check dependencies ──
    info "Checking dependencies..."

    # Node
    if command -v node >/dev/null 2>&1; then
      ok "Node: $(node --version)"
    else
      warn "Node: not installed (required)"
    fi

    # ripgrep
    WANT_RG=$(node -e "console.log(require('$DEPS_JSON').deps.ripgrep.version)")
    if command -v rg >/dev/null 2>&1; then
      CUR_RG=$(rg --version | head -1 | awk '{print $2}')
      ok "ripgrep: $CUR_RG (want >= $WANT_RG)"
    else
      warn "ripgrep: not installed (want >= $WANT_RG)"
    fi

    # Git
    if command -v git >/dev/null 2>&1; then
      ok "Git: $(git --version | awk '{print $3}')"
    else
      warn "Git: not installed"
    fi

    # ── Check self-update (silly-code repo) ──
    echo ""
    info "Checking for silly-code updates..."
    LOCAL_COMMIT=$(cd "$ROOT_DIR" && git rev-parse HEAD 2>/dev/null || echo "unknown")
    LOCAL_SHORT=$(cd "$ROOT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo "unknown")

    REMOTE_COMMIT=$(curl -fsSL -H "Accept: application/vnd.github.v3+json" \
      "https://api.github.com/repos/hilyfux/silly-code/commits/main" 2>/dev/null \
      | node -e "let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{try{console.log(JSON.parse(d).sha||'unknown')}catch{console.log('unknown')}})" 2>/dev/null \
      || echo "unknown")

    if [ "$REMOTE_COMMIT" = "unknown" ]; then
      warn "Could not check remote (offline or rate limited)"
    elif [ "$LOCAL_COMMIT" = "$REMOTE_COMMIT" ]; then
      ok "silly-code: up to date ($LOCAL_SHORT)"
    else
      REMOTE_SHORT="${REMOTE_COMMIT:0:7}"
      warn "silly-code: update available (local $LOCAL_SHORT → remote $REMOTE_SHORT)"
      if [ "$UPDATE_MODE" = "apply" ]; then
        info "Pulling latest..."
        cd "$ROOT_DIR"
        # Backup current binary before updating
        PATCHED="$ROOT_DIR/pipeline/build/cli-patched.js"
        if [ -f "$PATCHED" ]; then
          cp "$PATCHED" "$PATCHED.bak"
        fi
        if git pull --ff-only origin main 2>/dev/null; then
          ok "Updated to $(git rev-parse --short HEAD)"
          info "Rebuilding patched binary..."
          if node "$ROOT_DIR/pipeline/patch.cjs"; then
            ok "Binary updated"
            rm -f "$PATCHED.bak"
          else
            warn "Patch rebuild failed — restoring previous binary"
            if [ -f "$PATCHED.bak" ]; then
              mv "$PATCHED.bak" "$PATCHED"
              warn "Rolled back to previous working binary"
            fi
            warn "This may happen after an upstream Claude Code update"
            warn "Check: https://github.com/hilyfux/silly-code/issues"
          fi
        else
          warn "Pull failed — run 'silly update apply' again or reinstall"
          rm -f "$PATCHED.bak"
        fi
      else
        echo ""
        echo "  Run 'silly update apply' to update"
      fi
    fi

    # ── npm deps freshness ──
    echo ""
    if [ -f "$ROOT_DIR/bun.lock" ]; then
      ok "Lock file: bun.lock present"
    else
      warn "Lock file: missing (run bun install)"
    fi

    # Save check timestamp
    mkdir -p "$DATA_DIR"
    echo "{\"lastChecked\": \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" > "$DATA_DIR/deps-state.json"

    echo ""
    exit 0
    ;;
  uninstall)
    echo ""
    if [ -f "$ROOT_DIR/uninstall.sh" ]; then
      exec bash "$ROOT_DIR/uninstall.sh"
    else
      err "uninstall.sh not found. Re-install first or run:"
      echo "  curl -fsSL https://raw.githubusercontent.com/hilyfux/silly-code/main/uninstall.sh | bash"
      exit 1
    fi
    ;;
  report)
    # Bundle recent debug dumps for a bug report.
    # Usage: silly report          # create local bundle, print instructions
    #        silly report --submit # additionally open a GitHub issue via gh CLI
    SILLY_CODE_DATA="${SILLY_CODE_DATA:-$HOME/.silly-code}"
    DEBUG_DIR="/tmp/silly-debug"
    REPORTS_DIR="$SILLY_CODE_DATA/reports"

    if [ ! -d "$DEBUG_DIR" ] || [ -z "$(ls -A "$DEBUG_DIR" 2>/dev/null)" ]; then
      warn "No debug dumps found in $DEBUG_DIR"
      echo ""
      echo "  To capture one:"
      echo "    SILLY_DEBUG_DUMP=1 sillyx    # or sillyt/sillye"
      echo ""
      echo "  Reproduce the issue, then re-run 'silly report'."
      exit 1
    fi

    mkdir -p "$REPORTS_DIR"
    STAMP="$(date +%Y%m%d-%H%M%S)"
    STAGE="$REPORTS_DIR/$STAMP"
    mkdir -p "$STAGE"

    info "Collecting dumps from $DEBUG_DIR..."
    cp "$DEBUG_DIR"/*.json "$STAGE/" 2>/dev/null || true
    COUNT=$(ls "$STAGE"/*.json 2>/dev/null | wc -l | tr -d ' ')

    # Anonymize: strip $HOME paths, username, OAuth-shaped tokens
    # Keep message shapes + tool call names so the bug is diagnosable.
    info "Anonymizing $COUNT file(s)..."
    USERNAME=$(whoami)
    for f in "$STAGE"/*.json; do
      [ -f "$f" ] || continue
      # Replace $HOME with REDACTED_HOME, username tokens, and likely secrets
      node -e "
        const fs=require('fs');
        let s=fs.readFileSync('$f','utf8');
        s=s.split(process.env.HOME).join('REDACTED_HOME');
        s=s.split('$USERNAME').join('REDACTED_USER');
        // Bearer tokens / sk- API keys / eyJ JWTs
        s=s.replace(/Bearer\s+[A-Za-z0-9._\-]{10,}/g,'Bearer REDACTED_TOKEN');
        s=s.replace(/sk-[A-Za-z0-9_\-]{10,}/g,'REDACTED_SK');
        s=s.replace(/eyJ[A-Za-z0-9_\-]{20,}\.[A-Za-z0-9_\-]+\.[A-Za-z0-9_\-]+/g,'REDACTED_JWT');
        s=s.replace(/gho_[A-Za-z0-9]{30,}/g,'REDACTED_GH_TOKEN');
        s=s.replace(/ghp_[A-Za-z0-9]{30,}/g,'REDACTED_GH_PAT');
        fs.writeFileSync('$f',s);
      " 2>/dev/null || warn "  failed to anonymize $(basename "$f")"
    done

    # Add context: version, git HEAD, OS
    cat > "$STAGE/context.txt" <<CTX
silly-code report
=================
timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")
version: $(cd "$ROOT_DIR" && git rev-parse --short HEAD 2>/dev/null || echo unknown)
upstream: $(node -p "require('$ROOT_DIR/deps.json').deps.upstream.version" 2>/dev/null || echo unknown)
node: $(node --version 2>/dev/null || echo unknown)
os: $(uname -srv)
dumps: $COUNT
CTX

    BUNDLE="$REPORTS_DIR/silly-report-$STAMP.tar.gz"
    (cd "$REPORTS_DIR" && tar -czf "$(basename "$BUNDLE")" "$STAMP")
    SIZE=$(du -h "$BUNDLE" | awk '{print $1}')

    ok "Report bundle ready: $BUNDLE ($SIZE)"
    echo ""
    echo "  Contains:"
    echo "    - $COUNT anonymized debug dump(s)"
    echo "    - context.txt (version, OS, no PII)"
    echo ""

    if [ "${2:-}" = "--submit" ]; then
      if ! command -v gh >/dev/null 2>&1; then
        warn "'gh' CLI not installed — falling back to manual"
      elif ! gh auth status >/dev/null 2>&1; then
        warn "'gh' not authenticated — run 'gh auth login' first"
      else
        info "Opening issue on hilyfux/silly-code..."
        TITLE="bug report ($STAMP)"
        BODY="Auto-generated report from \`silly report --submit\`.

Attach the bundle manually after the issue opens — GitHub's API doesn't allow file uploads to issues.

\`\`\`
$(cat "$STAGE/context.txt")
\`\`\`

Bundle path: \`$BUNDLE\`
"
        URL=$(gh issue create \
          --repo hilyfux/silly-code \
          --title "$TITLE" \
          --body "$BODY" \
          --label "bug,user-report" 2>/dev/null)
        if [ -n "$URL" ]; then
          ok "Issue opened: $URL"
          echo "  Next: drag $BUNDLE into the issue comments to attach."
        else
          warn "gh issue create failed — see below for manual steps"
        fi
      fi
    fi

    echo "  Manual submission:"
    echo "    1. Open https://github.com/hilyfux/silly-code/issues/new"
    echo "    2. Drag $BUNDLE into the comment to attach"
    echo "    3. Describe what you expected vs what happened"
    echo ""
    exit 0
    ;;
  help|--help|-h)
    echo ""
    echo -e "  ${B}silly-code${N} — Multi-Provider AI Coding Assistant"
    echo ""
    echo "  Management:"
    echo "    silly status          Show provider auth status"
    echo "    silly login <prov>    Login to a provider"
    echo "    silly logout <prov>   Remove stored tokens"
    echo "    silly models          List available models"
    echo "    silly doctor          Check prerequisites"
    echo "    silly update          Check for updates"
    echo "    silly update apply    Apply available updates"
    echo "    silly cron install    Install local Claude-Code-driven upgrade loop (4h)"
    echo "    silly cron status     Show auto-upgrade loop status + recent logs"
    echo "    silly cron run        Run upgrade-check now (one-shot)"
    echo "    silly cron uninstall  Remove auto-upgrade loop"
    echo "    silly report          Bundle debug dumps for a bug report"
    echo "    silly report --submit Additionally open GitHub issue (needs gh)"
    echo "    silly uninstall       Remove silly-code completely"
    echo ""
    echo "  Launch:"
    echo "    sillyx                Start with Codex"
    echo "    sillyt                Start with Copilot"
    echo "    sillye                Start with Claude"
    echo ""
    exit 0
    ;;
  "")
    echo ""
    echo -e "  ${B}silly-code${N} — Multi-Provider AI Coding Assistant"
    echo ""
    check_provider "Codex   (sillyx)" "$CODEX_OAUTH" || true
    check_provider "Copilot (sillyt)" "$COPILOT_OAUTH" || true
    check_claude || true
    echo ""
    echo "  Get started:"
    echo "    silly login codex     Login to ChatGPT Pro / Codex"
    echo "    silly login copilot   Login to GitHub Copilot"
    echo "    silly login claude    Login to Claude Pro/Max"
    echo ""
    echo "  Then launch: sillyx / sillyt / sillye"
    echo ""
    exit 0
    ;;
  *)
    err "Unknown command: $1"
    echo "Run 'silly help' for usage."
    exit 1
    ;;
esac
