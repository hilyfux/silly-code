#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export CALLER_DIR="$(pwd -W 2>/dev/null || pwd)"
cd "$ROOT_DIR"
source "$ROOT_DIR/bin/silly-common.sh"

# Provider: Claude native (firstParty) — default, no env flag needed

export SILLY_CODE_DATA="${SILLY_CODE_DATA:-$HOME/.silly-code}"
mkdir -p "$SILLY_CODE_DATA"

_claude_logged_in() {
  # File-based stores (Linux, or user-moved config)
  [ -f "$SILLY_CODE_DATA/$CLAUDE_OAUTH" ] && return 0
  [ -f "$CLAUDE_CRED" ] && return 0
  # macOS Keychain (default on darwin)
  if [ "$(uname)" = "Darwin" ]; then
    security find-generic-password -s "Claude Code-credentials" -a "$USER" -w >/dev/null 2>&1 && return 0
  fi
  return 1
}

if ! _claude_logged_in; then
  echo ""
  echo "  sillye — Claude"
  echo ""
  info "Not logged in. The TUI will open — type /login to sign in."
  echo ""
  # Claude login happens inside the TUI via /login command.
  # Unlike Codex/Copilot, there's no standalone CLI login flow,
  # so we proceed directly to the TUI.
fi

ensure_patched_binary "$ROOT_DIR"

cd "$CALLER_DIR"
exec node "$PATCHED" "$@"
